rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserData(data, userId) {
      return data.userId == userId
        && data.userId == request.auth.uid
        && (data.email is string && data.email.size() <= 256)
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('theme' in data) || (data.theme in ['paper', 'night']))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Connection testing endpoint for boot verification
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User profile and synchronized learning data
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserData(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserData(request.resource.data, userId);
      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
